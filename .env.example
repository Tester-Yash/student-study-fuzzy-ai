# Copy this file to ".env" and fill in your own values.
# NEVER commit your real ".env" file or share your real API key.

# Which LLM provider to use: "groq" (default, free tier) or "openai"
LLM_PROVIDER=groq

# ---- Groq settings (used when LLM_PROVIDER=groq) ----
# Get a free API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# ---- OpenAI settings (used only when LLM_PROVIDER=openai) ----
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
